<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>io.github.qing936.xianyuops</groupId>
        <artifactId>xianyuops</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>xianyuops-server</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>
        后端 Server 的主项目，通过引入需要 xianyuops-module-xxx 的依赖，
        从而实现提供 RESTful API 给 xianyuops-ui-admin、xianyuops-ui-user 等前端项目。
        本质上来说，它就是个空壳（容器）！
    </description>
    <url>https://github.com/YunaiV/ruoyi-vue-pro</url>

    <dependencies>
        <dependency>
            <groupId>io.github.qing936.xianyuops</groupId>
            <artifactId>xianyuops-module-system</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>io.github.qing936.xianyuops</groupId>
            <artifactId>xianyuops-module-infra</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 闲鱼运营模块 -->
        <dependency>
            <groupId>io.github.qing936.xianyuops</groupId>
            <artifactId>xianyuops-module-xianyu</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- spring boot 配置所需依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 服务保障相关 -->
        <dependency>
            <groupId>io.github.qing936.xianyuops</groupId>
            <artifactId>xianyuops-spring-boot-starter-protection</artifactId>
        </dependency>

    </dependencies>

    <build>
        <!-- 设置构建的 jar 包名 -->
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <!-- 打包 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal> <!-- 将引入的 jar 打入其中 -->
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- BouncyCastle 提供者必须解包加载，否则打为 fat jar 后 JCE 无法认证其签名，
                         报 SecurityException: JCE cannot authenticate the provider BC -->
                    <requiresUnpack>
                        <dependency>
                            <groupId>org.bouncycastle</groupId>
                            <artifactId>bcprov-jdk18on</artifactId>
                        </dependency>
                        <dependency>
                            <groupId>org.bouncycastle</groupId>
                            <artifactId>bcpkix-jdk18on</artifactId>
                        </dependency>
                    </requiresUnpack>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
